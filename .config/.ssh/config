# GitLab Tain
Host git.tain.com
  HostName git.tain.com
  User git
  Port 2222
  IdentityFile ~/.ssh/identity
  PreferredAuthentications publickey

# GitLab Eeze (new domain); key decrypted from .config/secrets/ssh-eeze.age
Host git-ssh.eeze.com
  HostName git-ssh.eeze.com
  User git
  Port 22
  IdentityFile ~/.ssh/id_ed25519_eeze
  IdentitiesOnly yes
  PreferredAuthentications publickey

Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/iddentity
